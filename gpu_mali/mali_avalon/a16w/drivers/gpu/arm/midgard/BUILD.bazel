load(
    "//build/bazel_mgk_rules:mgk_ddk_ko.bzl",
    "define_mgk_ddk_ko",
)

load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")

load("//vendor/mediatek/kernel_modules/gpu/gpu_mali/mali_avalon/a16w/config:cflags.bzl", "CFLAGS_MODULE", "COPTS_KBASE", "COPTS_MTK")
load("@mgk_info//:kernel_version.bzl", "kernel_version")

package(
    default_visibility = [
        "//visibility:public",
    ],
)

filegroup(
    name = "ddk_kconfigs",
    srcs = glob([
        "**/Kconfig",
    ]),
)

ddk_headers(
    name = "mali_kernel_headers",
    hdrs = [
        ":midgard_headers",
        "//vendor/mediatek/kernel_modules/gpu/gpu_mali/mali_avalon/a16w:kernel_headers",
        "//vendor/mediatek/kernel_modules/gpu/gpu_mali/mali_avalon/a16w/drivers/gpu/arm:mali_arbitration_shared_config_defaults",
    ],
)

ddk_headers(
    name = "midgard_headers",
    hdrs = glob(["**/*.h"]),
    includes = [
        ".",
        "arbiter",
        "arbiter/backend",
        "backend/gpu",
        "context",
        "csf",
        "csf/ipa_control",
        "debug",
        "debug/backend",
        "device",
        "gpu",
        "hw_access",
        "hw_access/regmap",
        "hwcnt",
        "hwcnt/backend",
        "ipa",
        "ipa/backend",
        "mmu",
        "mmu/backend",
        "thirdparty",
        "tl",
        "include",
        "include/linux",
	"platform",
    ],
)

filegroup(
    name = "midgard_kconfig",
    srcs = [
        "Kconfig",
        "MTK_Kconfig",
    ] + select({
        "//vendor/mediatek/kernel_modules/gpu/gpu_mali/mali_avalon/a16w/config:mali_debug_kutf": ["//drivers/gpu/arm/midgard/tests:kutf_kconfig"],
        "//conditions:default": [],
    }),
)

platforms = [
    "mt6991",
    "mt6993",
    "mt6895",
    "mt6858",
]

[define_mgk_ddk_ko(
    name = "mali_kbase_{}_a16w".format(p),
    srcs = glob(
        ["*.c"],
        exclude = [
            "mali_kbase_pbha_debugfs.c",
            "mali_kbase_fence_ops.c",
            "mali_kbase_sync_file.c",
            "mali_kbase_sync_common.c",
            "mali_power_gpu_work_period_trace.c",
            "mali_kbase_gpu_metrics.c",
            "mali_kbase_moduleprops.c",
            "mali_kbase_power_debugfs.c",
            "mali_kbase_regs_dump_debugfs.c",
            "mali_kbase_fpga_sysctl.c",
        ],
    ) + glob(
        ["arbiter/*.c"],
        exclude = [
            "arbiter/mali_kbase_aw.c",
            "arbiter/backend/mali_kbase_aw_backend_csf.c",
        ],
    ) + glob(
        ["backend/gpu/*.c"],
        exclude = [
            "backend/gpu/mali_kbase_pm_always_on_demand.c",
            "backend/gpu/mali_kbase_devfreq.c",
            "backend/gpu/mali_kbase_model_linux.c",
            "backend/gpu/mali_kbase_model_dummy.c",
        ],
    ) + glob(
        [
            "context/*.c",
            "context/backend/*.c",
        ],
    ) + glob(
        [
            "csf/*.c",
            "csf/ipa_control/*.c",
        ],
        exclude = [
            "csf/mali_kbase_csf_firmware_no_mali.c",
            "csf/mali_kbase_csf_fw_io_no_mali.c",
            "csf/mali_kbase_csf_firmware.c",
            "csf/mali_kbase_csf_fw_io.c",
            "csf/mali_kbase_debug_csf_fault.c",
        ],
    ) + glob(
        [
            "debug/*.c",
            "debug/backend/*.c",
        ],
        exclude = [
            "debug/backend/mali_kbase_debug_coresight_csf.c",
        ],
    ) + glob(
        [
            "device/*.c",
            "device/backend/*.c",
        ],
    ) + glob(
        [
            "gpu/*.c",
            "gpu/backend/*.c",
        ],
    ) + glob(
        [
            "hw_access/*.c",
            "hw_access/regmap/*.c",
        ],
    ) + glob(
        [
            "hwcnt/*.c",
            "hwcnt/backend/*.c",
        ],
    ) + glob(
        [
            "mmu/*.c",
            "mmu/backend/*.c",
        ],
    ) + glob(
        ["thirdparty/*.c"],
    ) + glob(
        [
            "tl/*.c",
            "tl/backend/*.c",
        ],
        exclude = [
            "tl/mali_kbase_timeline_test.c",
        ],
    )  + glob(
        [
            "platform/*.c",
            "platform/mtk_platform_common/*.c",
            "platform/{}/*.c".format(p),
        ],
    ),
    out = "mali_kbase_{}_a16w.ko".format(p),
    hdrs = [
        ":mali_kernel_headers",
    ],
    #MTK add
    includes = [
        "platform/{}".format(p),
        "platform/mtk_platform_common",
    ],
    conditional_srcs = {
        "CONFIG_DEBUG_FS": {
            True: [
                "mali_kbase_pbha_debugfs.c",
                "csf/mali_kbase_debug_csf_fault.c",
                "ipa/mali_kbase_ipa_debugfs.c",
            ],
        },
        "CONFIG_SYNC_FILE": {
            True: [
                "mali_kbase_fence_ops.c",
                "mali_kbase_sync_file.c",
                "mali_kbase_sync_common.c",
            ],
        },
        "CONFIG_MALI_TRACE_POWER_GPU_WORK_PERIOD": {
            True: [
                "mali_power_gpu_work_period_trace.c",
                "mali_kbase_gpu_metrics.c",
            ],
        },
        "CONFIG_MALI_NO_MALI": {
            True: [
                "backend/gpu/mali_kbase_model_linux.c",
                "backend/gpu/mali_kbase_model_dummy.c",
                "csf/mali_kbase_csf_firmware_no_mali.c",
                "csf/mali_kbase_csf_fw_io_no_mali.c",
            ],
            False: [
                "csf/mali_kbase_csf_firmware.c",
                "csf/mali_kbase_csf_fw_io.c",
            ],
        },
        "CONFIG_MALI_REAL_HW": {
            True: [
                "hw_access/backend/mali_kbase_hw_access_real_hw.c",
            ],
            False: [
                "hw_access/backend/mali_kbase_hw_access_model_linux.c",
            ],
        },
        "CONFIG_MALI_DEVFREQ": {
            True: [
                "backend/gpu/mali_kbase_devfreq.c",
                "ipa/mali_kbase_ipa_simple.c",
                "ipa/mali_kbase_ipa.c",
                "ipa/backend/mali_kbase_ipa_counter_csf.c",
                "ipa/backend/mali_kbase_ipa_counter_common_csf.c",
            ] + glob([
                "ipa/*.h",
                "ipa/backend/*.h",
            ]),
        },
    },
    local_defines = COPTS_KBASE,
    copts = CFLAGS_MODULE + COPTS_MTK,
    defconfig = "//vendor/mediatek/kernel_modules/gpu/gpu_mali/mali_avalon/a16w/config/fragment:kbase_defconfig_{}".format(p),
    kconfig = ":midgard_kconfig",
    header_deps = [
        "//kernel_device_modules-{}/drivers/gpu/mediatek/ged:ged_public_headers".format(kernel_version),
        "//kernel_device_modules-{}/drivers/gpu/mediatek/gpu_pdma:gpu_pdma_public_headers".format(kernel_version),
        "//kernel_device_modules-{}/drivers/gpu/mediatek/gpueb:gpueb_public_headers".format(kernel_version),
        "//kernel_device_modules-{}/drivers/gpu/mediatek/gpufreq:mtk_gpufreq_headers".format(kernel_version),
        "//kernel_device_modules-{}/drivers/gpu/mediatek/gpufreq/v2:gpufreq_public_headers".format(kernel_version),
        "//kernel_device_modules-{}/drivers/gpu/mediatek/mt-plat:gpu_utility_headers".format(kernel_version),
        "//kernel_device_modules-{}/drivers/misc/mediatek/perf_common:headers".format(kernel_version),
        "//kernel_device_modules-{}/drivers/misc/mediatek/tinysys_scmi:ddk_public_headers".format(kernel_version),
        "//kernel_device_modules-{}/drivers/misc/mediatek/trusted_mem:tmem_hdrs".format(kernel_version),
    ],
    ko_deps = [
        "//kernel_device_modules-{}/drivers/dma-buf/heaps:mtk_sec_heap".format(kernel_version),
        "//kernel_device_modules-{}/drivers/gpu/mediatek/ged:ged".format(kernel_version),
        "//kernel_device_modules-{}/drivers/gpu/mediatek/gpueb:mtk_gpueb".format(kernel_version),
        "//kernel_device_modules-{}/drivers/gpu/mediatek/gpufreq/v2:mtk_gpufreq_wrapper".format(kernel_version),
        "//kernel_device_modules-{}/drivers/gpu/mediatek/hal:mtk_gpu_hal".format(kernel_version),
        "//kernel_device_modules-{}/drivers/misc/mediatek/aee/aed:aee_aed".format(kernel_version),
        "//kernel_device_modules-{}/drivers/misc/mediatek/aee/mrdump:mrdump".format(kernel_version),
        "//kernel_device_modules-{}/drivers/misc/mediatek/geniezone:gz_tz_system".format(kernel_version),
        "//kernel_device_modules-{}/drivers/misc/mediatek/sda:irq-dbg".format(kernel_version),
        "//kernel_device_modules-{}/drivers/misc/mediatek/slbc:mtk_slbc".format(kernel_version),
	"//kernel_device_modules-{}/drivers/misc/mediatek/trusted_mem:trusted_mem".format(kernel_version),
    ] + ([
        "//kernel_device_modules-{}/drivers/gpu/mediatek/gpu_pdma:mtk_gpu_pdma_mt6991".format(kernel_version),
    ] if p in ["mt6991"] else [
        "//kernel_device_modules-{}/drivers/gpu/mediatek/gpu_pdma:mtk_gpu_pdma_mt6993".format(kernel_version),
    ] if p in ["mt6993"] else[
        "//kernel_device_modules-{}/drivers/misc/mediatek/tinysys_scmi:tinysys-scmi".format(kernel_version),
    ] if p in ["mt6895"] else[
        "//kernel_device_modules-{}/drivers/misc/mediatek/tinysys_scmi:tinysys-scmi".format(kernel_version),
    ] if p in ["mt6858"] else[
    ]),
) for p in platforms]
