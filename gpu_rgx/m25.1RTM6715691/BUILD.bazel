# Illustration of generate_config_setting_multiple_string(...):
# Example of config PVR_HANDLE_BACKEND:
# It creates config_setting of
#   cs_PVR_HANDLE_BACKEND_generic
#   cs_PVR_HANDLE_BACKEND_idr
# and string_flag PVR_HANDLE_BACKEND.
# if PVR_HANDLE_BACKEND is generic, cs_PVR_HANDLE_BACKEND_generic is enable
# if PVR_HANDLE_BACKEND is idr, cs_PVR_HANDLE_BACKEND_idr is enable
# The value can be modified in .bazelrc
#
generate_config_setting_multiple_string("cs_PVR_HANDLE_BACKEND", "PVR_HANDLE_BACKEND",  default_empty, available_values=["generic", "idr", ""])
# cs_PVR_ARCH_rogue, cs_PVR_ARCH_volcanic
generate_config_setting_multiple_string("cs_PVR_ARCH", "PVR_ARCH",  default_empty, available_values=["rogue", "volcanic", ""])
# cs_PVRSRV_DIR_services
generate_config_setting_multiple_string("cs_PVRSRV_DIR", "PVRSRV_DIR",  default_empty, available_values=["services", ""])
generate_config_setting_multiple_string("cs_PVR_SYSTEM", "PVR_SYSTEM",  default_empty, available_values=["rgx_linux_tc", "mt8173", ""])
generate_config_setting_string("cs_PVRSRV_PHYSMEM_CPUMAP_HISTORY", "PVRSRV_PHYSMEM_CPUMAP_HISTORY", "1", default_empty, available_values=["0", "1", ""])


