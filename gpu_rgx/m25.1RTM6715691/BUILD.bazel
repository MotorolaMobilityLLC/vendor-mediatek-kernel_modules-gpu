                      FILES_PVRSRV_ENABLE_HTB_common +
                      FILES_SUPPORT_WRAP_EXTMEM +
                      FILES_PVRSRV_ENABLE_DYNAMIC_PHYSHEAPS +
                      FILES_SUPPORT_DMA_TRANSFER_common +

                    [
						"**/*.mk",
						"services/server/env/linux/physmem_test.c",
						"services/server/env/linux/pvr_gputrace.c",
