mt6877_outs = [
    "mt6877/mali_valhall/mali-r32p1/drivers/gpu/arm/midgard/mali_kbase_mt6877.ko",
    "mt6877/mali_valhall/mali-r32p1/drivers/base/arm/protected_memory_allocator/mali_prot_alloc_mt6877.ko",
    "mt6877/mali_valhall/mali-r32p1/drivers/base/arm/memory_group_manager/mali_mgm_mt6877.ko",
