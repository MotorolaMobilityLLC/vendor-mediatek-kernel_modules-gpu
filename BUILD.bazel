]

define_mgk_ko(
    name = "gpu",
    srcs = glob(["**"]),
    outs = (
        mt6897_outs if glob(["mt6897/*"]) else []
    ) + (
        mt6989_outs if glob(["mt6989/*"]) else []
    ) + (
        mt6991_outs if glob(["mt6991/*"]) else []
    ),
)

define_mgk_ko(
    name = "gpu_mt6768",
    srcs = glob(["**"]),
    outs = (
    mt6768_outs if glob(["mt6768/*"]) else []
    ),
)

define_mgk_ko(
    name = "gpu_mt6877",
    srcs = glob(["**"]),
    outs = (
    mt6877_outs if glob(["mt6877/*"]) else []
    ),
)

define_mgk_ko(
    name = "gpu_mt6893",
    srcs = glob(["**"]),
    outs = (
    mt6893_outs if glob(["mt6893/*"]) else []
    ),
)
